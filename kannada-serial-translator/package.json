{
  "name": "anuvaada",
  "productName": "Anuvaada",
  "version": "1.4.0",
  "description": "Tamil serial audio to natural spoken Kannada \u2014 transcribe, translate and speak back, for remake script writers.",
  "main": "src/main/main.js",
  "author": "mindunter",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.mindunter.anuvaada",
    "productName": "Anuvaada",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Anuvaada listens to Tamil dialogue from your microphone to translate it into Kannada.",
        "NSAudioCaptureUsageDescription": "Anuvaada listens to the episode playing on your computer to translate it into Kannada.",
        "NSScreenCaptureUsageDescription": "Anuvaada captures the sound of the episode playing on your computer (no video is recorded)."
      },
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mindunter/mindunter.git"
  }
}
